diff --git a/ggml/src/ggml-cpu/tiled/tiled.cpp b/ggml/src/ggml-cpu/tiled/tiled.cpp
index 77e1a99..fc6d453 100644
--- a/ggml/src/ggml-cpu/tiled/tiled.cpp
