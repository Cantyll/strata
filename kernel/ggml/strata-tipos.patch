+// STRATA tipos D (sub-células por tensor): v = d·sc·c − dmin·mn + (d/2^(k+4))·sc·δ, com δ = tab[r + 2^k·classe] (int8).
+// O valor não cabe num código de 8 bits, então o tile roda duas vezes sobre os mesmos pesos, somando no mesmo acc:
+//   passada A: o código c (Q4: 0 a 15, BIAS 0, com mínimo; Q6: q + 32, BIAS 32, sem mínimo)
+//   passada B: δ + 128 (BIAS 128, sem mínimo), d do tile = d/2^(k+4)
+// A tabela do tensor vem de ggml_strata_tab_atual(), definida no começo de cada pedaço (one_chunk).
+struct strata_blk_q4kd1 { uint8_t b[176]; };
+struct strata_blk_q4kd2 { uint8_t b[208]; };
+struct strata_blk_q6kd1 { uint8_t b[242]; };
+struct strata_blk_q6kd2 { uint8_t b[274]; };
+template <typename B> struct strata_tiled_d { static constexpr bool value = false; };
+template <> struct strata_tiled_d<strata_blk_q4kd1> { static constexpr bool value = true; };
+template <> struct strata_tiled_d<strata_blk_q4kd2> { static constexpr bool value = true; };
+template <> struct strata_tiled_d<strata_blk_q6kd1> { static constexpr bool value = true; };
+template <> struct strata_tiled_d<strata_blk_q6kd2> { static constexpr bool value = true; };
+
+// índice completo i = 2^k·c + r nos 256 pesos de q; passada A: q = c; passada B: q = δ + 128
+template <int K, int CMAX, bool PASSADA_B>
+static inline void strata_tiled_d_codigos(uint8_t * q, const int8_t * tab) {
+#if defined(__AVX2__)
+    const __m256i T  = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i *) tab));
+    const __m256i mr = _mm256_set1_epi8((1 << K) - 1), K2 = _mm256_set1_epi8(1 << K), mc = _mm256_set1_epi8((char) (0xFF >> K));
+    const __m256i z  = _mm256_setzero_si256(), cmax = _mm256_set1_epi8(CMAX), b128 = _mm256_set1_epi8((char) 0x80);
+    for (int g = 0; g < 8; g++) {
+        const __m256i u = _mm256_loadu_si256((const __m256i *) (q + 32 * g));
+        const __m256i c = _mm256_and_si256(_mm256_srli_epi16(u, K), mc);
+        if constexpr (!PASSADA_B) {
+            _mm256_storeu_si256((__m256i *) (q + 32 * g), c);
+        } else {
+            const __m256i idx = _mm256_add_epi8(_mm256_add_epi8(_mm256_and_si256(u, mr), K2),
+                _mm256_sub_epi8(_mm256_and_si256(_mm256_cmpeq_epi8(c, cmax), K2), _mm256_and_si256(_mm256_cmpeq_epi8(c, z), K2)));
+            _mm256_storeu_si256((__m256i *) (q + 32 * g), _mm256_xor_si256(_mm256_shuffle_epi8(T, idx), b128));
+        }
+    }
+#else
+    for (int e = 0; e < TILED_TILE_K; e++) {
+        const int c = q[e] >> K;
+        if constexpr (!PASSADA_B) {
+            q[e] = (uint8_t) c;
+        } else {
+            const int classe = c == 0 ? 0 : c == CMAX ? 2 : 1;
+            q[e] = (uint8_t) (128 + tab[(q[e] & ((1 << K) - 1)) + (classe << K)]);
+        }
+    }
+#endif
+}
